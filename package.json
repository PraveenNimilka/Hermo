{
  "name": "hermo-local",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "node --test tests/workflow.test.mjs",
    "test:public": "node scripts/verify-public.mjs",
    "test:consumers": "node --test validation-apps/tests/*.test.mjs",
    "test:real-world": "node scripts/verify-real-world.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.2.0",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "description": "Turn authorized website workflows into local REST APIs and MCP tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/PraveenNimilka/Hermo.git"
  },
  "keywords": [
    "browser-automation",
    "local-first",
    "rest-api",
    "mcp",
    "chrome-extension",
    "developer-tools"
  ]
}
